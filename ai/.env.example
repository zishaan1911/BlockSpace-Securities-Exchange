# Copy to .env and fill in real values. Never commit .env or real keys
# (GLOSSARY.md's Golden Rules). All variables are GASX_AI_-prefixed and
# read by config.py via pydantic-settings.

# Ethereum ingestion (ingestion/ethereum.py). Any JSON-RPC endpoint with
# eth_getBlockByNumber/eth_feeHistory support; txpool_status is used if
# available but not required (see ingestion/ethereum.py).
GASX_AI_ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com

# EGSI history buffer size (features/history.py).
GASX_AI_EGSI_HISTORY_MAX_LEN=200

# Seconds between automatic EGSI cycles. Defaults to 12, matching
# Ethereum's block time — cycling faster cannot surface new data, since
# there is no new block to read; it only burns RPC rate limit and
# recomputes an identical score. Set to 0 to disable auto-cycling and
# drive the service manually with POST /cycle.
GASX_AI_CYCLE_INTERVAL_SECONDS=12

# Serve the trained model even if it did not beat its naive baselines.
# ARCHITECTURE.md §4 says to ship the baseline in that case, and on
# measured data the baseline is genuinely more accurate. Set true to show
# the model's own output anyway; it is then labelled "-unvalidated" all
# the way to the UI.
GASX_AI_SERVE_UNVALIDATED_MODEL=false
