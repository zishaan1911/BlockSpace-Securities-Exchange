Thumbs.db
.idea/
.vscode/
*.swp

# Logs
*.log
logs/
logs/

# Move CLI per-machine publish record -- never project state, and
# committing it would make every clone fight over reusing one publish.
Published.toml
**/build/*/Published.toml
*.pubfile.json
