# Sui network: "testnet" | "mainnet"
VITE_NETWORK=testnet

# API gateway (real backend; leave unset to force mock mode)
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws

# Force the simulated demo feed even if the API is reachable
VITE_USE_MOCK=true

# Deployed gasx Move package ID on Sui (empty until Phase 1 deployment exists)
VITE_GASX_PACKAGE_ID=

# Full USDC coin type for the chain in use, e.g. 0x...::usdc::USDC
VITE_USDC_COIN_TYPE=
