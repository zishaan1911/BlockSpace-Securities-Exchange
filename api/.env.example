# Copy to .env and fill in real values. Never commit .env or real keys
# (GLOSSARY.md's Golden Rules). This gateway itself never holds any
# private key — see blockchain/sui/README.md and blockchain/thetanuts/README.md
# for the two adapters' own .env files, which this gateway also needs
# filled in (blockchain/sui/.env for reads/tx-prep, blockchain/thetanuts/.env
# for market data — its hedge wallet key is optional here since this
# gateway doesn't call requestHedgeQuote yet, only getVolSignal).
# On startup the gateway loads ./.env, ../blockchain/sui/.env and
# ../blockchain/thetanuts/.env (each optional) into the process
# environment — see src/index.ts.
#
# Until contracts/gasx is deployed, leave blockchain/sui's IDs empty:
# the Sui adapter's dev-market mode serves a synthetic market so this
# whole stack runs locally (see blockchain/sui/README.md).

GASX_API_PORT=3000

# Base URL of the Python AI service (ai/main.py). Run it separately —
# see ai/README.md.
GASX_API_AI_SERVICE_URL=http://localhost:8000

# ARCHITECTURE.md §8's Hard Risk Policy constants. Defaults are
# reasonable for a demo; override for a different budget.
GASX_API_MAX_ORDER_CONTRACTS=100
GASX_API_MAX_POSITION_CONTRACTS=500
GASX_API_MAX_SLIPPAGE_BPS=100
GASX_API_MIN_MODEL_CONFIDENCE_PCT=70
GASX_API_MAX_HEDGE_NOTIONAL=1000

# ETH-beta exposure (ARCHITECTURE.md §10's hedge trigger). GASX_API_ETH_BETA
# is a configured ASSUMPTION about how much ETH exposure one unit of EGSI
# exposure implies — a real value would be regressed from EGSI-vs-ETH
# return history, which does not exist yet. See api/src/exposure.ts.
GASX_API_ETH_BETA=0.5
GASX_API_HEDGE_THRESHOLD_NOTIONAL=5000
# Option contracts per hedge RFQ. Fractional is allowed (the SDK converts
# using the collateral token decimals); values below 0.01 are floored.
GASX_API_HEDGE_CONTRACTS=1
GASX_API_HEDGE_OFFER_DEADLINE_MINUTES=10

# MySQL durable state (database/README.md). Optional — leave unset and
# the gateway runs statelessly, which keeps the dev-market path working
# with no MySQL install at all.
GASX_API_DATABASE_URL=mysql://gasx:gasx@localhost:3306/gasx

# How far out to place the hedge option's expiry, in hours. Deliberately
# separate from the vol signal's expiry: that one is the nearest expiry
# with enough quotes to measure ATM IV, which is often sooner than the
# RFQ's own offer deadline, and Thetanuts rejects an option expiring
# before market makers finish quoting it.
GASX_API_HEDGE_EXPIRY_HOURS=24

# Groq API key for the platform-explainer chat assistant
# (POST /api/v1/chat). Undefined disables the route (501) rather than
# degrading silently. Get a key at https://console.groq.com.
GASX_API_GROQ_API_KEY=
# llama-3.3-70b-versatile was deprecated by Groq in 2026-07; the current
# recommended models are the openai/gpt-oss family. gpt-oss-20b is the
# smaller, faster one -- plenty for a chat widget answering questions
# about the platform.
GASX_API_GROQ_MODEL=openai/gpt-oss-20b
