{
  "name": "@gasx/api",
  "version": "0.1.0",
  "private": true,
  "description": "GASX API gateway (ARCHITECTURE.md \u00a72, \u00a79): REST endpoints for market state, order/account transaction preparation, and the Thetanuts-signal-to-EGSI bridge. Enforces ARCHITECTURE.md \u00a78's hard risk policy on order preparation.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@gasx/sui-adapter": "file:../blockchain/sui",
    "@gasx/thetanuts-adapter": "file:../blockchain/thetanuts",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
