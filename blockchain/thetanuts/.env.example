# Copy to .env and fill in real values. Never commit .env or real keys
# (GLOSSARY.md's Golden Rules).

# Base mainnet JSON-RPC URL. Thetanuts has no testnet deployment (see
# README.md) — this is the only chain OptionBook/RFQ operations work
# against, even for the read-only getVolSignal/getBestCandidate calls.
GASX_THETANUTS_BASE_RPC_URL=https://mainnet.base.org

# Hex private key for a dedicated, isolated hedge wallet
# (ARCHITECTURE.md §8: "Hedge wallet — isolated from user funds; Base +
# [ETH, USDC] only"). Required only for requestHedgeQuote (submits a
# real RFQ transaction) — leave blank to use this adapter read-only
# (getVolSignal, and getBestCandidate against an existing quotationId).
# Fund with only what a hedge actually needs, never more.
GASX_THETANUTS_HEDGE_WALLET_PRIVATE_KEY=
