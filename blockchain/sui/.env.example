# Copy to .env and fill in real values. Never commit .env or real keys
# (GLOSSARY.md's Golden Rules — though this adapter never handles keys
# at all; it only prepares transactions for a wallet to sign).

# Sui fullnode JSON-RPC URL. setup.md has the user configure the CLI
# against this same testnet endpoint.
GASX_SUI_RPC_URL=https://fullnode.testnet.sui.io:443
GASX_SUI_NETWORK=testnet

# Deployed contracts/gasx package ID (from `sui client publish`).
GASX_SUI_PACKAGE_ID=

# The EGSI-1H Market object ID (from gasx::market::create_market's
# return value / the resulting object on Sui explorer).
GASX_SUI_MARKET_ID=

# The OracleState object ID this market references (from
# gasx::oracle::create_oracle's return value).
GASX_SUI_ORACLE_ID=

# Fully-qualified Move type of the collateral coin, e.g. testnet USDC's
# type, or a local test coin's type while developing.
GASX_SUI_COLLATERAL_COIN_TYPE=
