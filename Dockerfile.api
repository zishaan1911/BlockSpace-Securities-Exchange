# GASX API gateway. Builds the C++ order-engine addon plus the two chain
# adapters it links against, then runs the Fastify gateway.
#
# Build context is the repo root: the gateway depends on ../blockchain/sui,
# ../blockchain/thetanuts and ../engine/binding as npm `file:` packages.

# ---- build ----
FROM node:20-bookworm-slim AS build

# node-gyp needs python3 + make + g++ to compile the C++ engine addon.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Package manifests first so `npm ci` layers stay cached across source-only
# changes (a frontend/ai edit no longer re-downloads the gateway's deps).
COPY blockchain/sui/package.json blockchain/sui/package-lock.json blockchain/sui/
COPY blockchain/thetanuts/package.json blockchain/thetanuts/package-lock.json blockchain/thetanuts/
COPY api/package.json api/package-lock.json api/

# The C++ engine addon is compiled by engine/binding's install script, which
# needs the engine sources present at install time.
COPY engine/ ./engine/

RUN npm --prefix blockchain/sui ci
RUN npm --prefix blockchain/thetanuts ci
# Builds the native N-API addon via its install script.
RUN npm --prefix engine/binding ci
# Gateway deps (symlinks the file: packages); tsx runs the source directly.
RUN npm --prefix api ci

# Remaining source, then compile the two adapters the gateway links against.
COPY blockchain/sui/ ./blockchain/sui/
COPY blockchain/thetanuts/ ./blockchain/thetanuts/
COPY api/ ./api/

RUN npm --prefix blockchain/sui run build
RUN npm --prefix blockchain/thetanuts run build

# ---- runtime ----
FROM node:20-bookworm-slim

WORKDIR /app

COPY --from=build /app/blockchain ./blockchain
COPY --from=build /app/engine/binding ./engine/binding
COPY --from=build /app/api ./api

WORKDIR /app/api

EXPOSE 3000

CMD ["npx", "tsx", "src/index.ts"]
